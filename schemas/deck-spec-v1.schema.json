            "$ref": "#/$defs/CoverSlide"
          },
          {
            "$ref": "#/$defs/BulletsSlide"
          },
          {
            "$ref": "#/$defs/TwoColumnSlide"
          },
          {
            "$ref": "#/$defs/ChartSlide"
          },
          {
            "$ref": "#/$defs/TableSlide"
          },
